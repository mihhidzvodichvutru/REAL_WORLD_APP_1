          "name": "Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra mã trạng thái trả về (201 Created hoặc 200 OK tùy cấu hình Backend)\r",
                  "pm.test(\"Đăng ký tài khoản thành công\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// 2. Tự động trích xuất token ngay sau khi đăng ký thành công\r",
                  "var jsonData = pm.response.json();\r",
                  "if (jsonData.user && jsonData.user.token) {\r",
                  "    pm.environment.set(\"token\", jsonData.user.token);\r",
                  "    pm.environment.set(\"registered_username\", jsonData.user.username);\r",
                  "    console.log(\"✨ Đăng ký thành công tài khoản: [\" + jsonData.user.username + \"] và đã lưu token vào môi trường!\");\r",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
