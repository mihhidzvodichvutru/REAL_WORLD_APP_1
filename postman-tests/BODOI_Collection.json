                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra mã phản hồi tạo bài viết thành công là 201 Created (hoặc 200 OK)\r",
                  "pm.test(\"Tạo bài viết thành công\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// 2. Bóc tách dữ liệu JSON từ Server trả về\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// 3. Tự động bóc tách slug và lưu vào biến môi trường (Có cơ chế bảo vệ an toàn)\r",
                  "if (jsonData.article && jsonData.article.slug) {\r",
                  "    var articleSlug = jsonData.article.slug;\r",
                  "    \r",
                  "    // Lưu vào biến môi trường\r",
                  "    pm.environment.set(\"slug\", articleSlug);\r",
                  "    \r",
                  "    // In log ra Console để dễ debug\r",
                  "    console.log(\"🔥 Đã bắt được Slug bài viết: \" + articleSlug);\r",
                  "    \r",
                  "    // Test case xác nhận đã bắt được biến\r",
                  "    pm.test(\"🚀 Lưu Slug bài viết vào môi trường thành công\", function () {\r",
                  "        pm.expect(articleSlug).to.not.be.empty;\r",
                  "    });\r",
                  "} else {\r",
                  "    console.log(\"❌ Không tìm thấy slug trong response. Vui lòng kiểm tra lại body trả về!\");\r",
                  "}"
                ]
