          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra trạng thái gọi API thành công\r",
                  "pm.test(\"Trạng thái trả về là 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// 2. Kiểm tra cấu trúc trả về phải có mảng 'comments'\r",
                  "pm.test(\"Dữ liệu trả về phải chứa mảng 'comments'\", function () {\r",
                  "    pm.expect(jsonData).to.have.property('comments');\r",
                  "    pm.expect(jsonData.comments).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "// 3. Hiển thị danh sách ra Console và kiểm tra chéo\r",
                  "if (jsonData.comments && jsonData.comments.length > 0) {\r",
                  "    // In danh sách ra Postman Console để huynh dễ nhìn\r",
                  "    console.log(\"🔥 Đã lấy được \" + jsonData.comments.length + \" bình luận!\");\r",
                  "    console.log(\"Chi tiết danh sách:\", jsonData.comments);\r",
                  "\r",
