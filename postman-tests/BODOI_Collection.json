                "exec": [
                  "pm.test(\"Status code là 200 OK (Sửa bài thành công)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// Áo giáp: Chỉ test dữ liệu nếu update thành công (có cục article)\r",
                  "if (pm.response.code === 200 && jsonData.article) {\r",
                  "    pm.test(\"Tiêu đề và nội dung đã được cập nhật\", function () {\r",
                  "        // Chỉ cần check xem title có chứa chữ \"update\" là được, vì nó có nối đuôi timestamp ngẫu nhiên\r",
                  "        pm.expect(jsonData.article.title).to.include(\"update bằng Postman\");\r",
                  "    });\r",
                  "\r",
                  "    if (jsonData.article.slug) {\r",
                  "        pm.environment.set(\"slug\", jsonData.article.slug);\r",
                  "        console.log(\"🔄 Đã cập nhật lại Slug mới sau khi sửa: \" + jsonData.article.slug);\r",
                  "    }\r",
                  "} else {\r",
                  "    console.error(\"❌ Update thất bại hoặc trùng lặp. Server trả về:\", JSON.stringify(jsonData));\r",
                  "}"
                ]
              }
            }
