                  "pm.test(\"Bài viết trả về phải khớp chuẩn xác với Slug vừa tạo\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.article.slug).to.eql(pm.environment.get(\"slug\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response body chứa đầy đủ thông tin bài viết\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('article');\r",
                  "    pm.expect(jsonData.article).to.have.property('title');\r",
                  "    pm.expect(jsonData.article).to.have.property('body');\r",
                  "});"
